<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0D0D0F">

    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="#1E1E1E"
        app:titleTextColor="#FFFFFF" app:subtitleTextColor="#9A9AA5"/>

    <ScrollView android:id="@+id/scrollView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/outputText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="12dp"
            android:fontFamily="monospace" android:textSize="13sp"
            android:textColor="#D4D4D8" android:textIsSelectable="true"/>
    </ScrollView>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#141418" android:scrollbars="none">
        <LinearLayout android:id="@+id/quickKeys" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:padding="6dp"/>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#17171B" android:paddingStart="14dp" android:paddingEnd="10dp"
        android:paddingTop="8dp" android:paddingBottom="8dp">

        <TextView android:id="@+id/promptText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:fontFamily="monospace"
            android:textColor="#7FD67F" android:textSize="14sp"/>

        <EditText android:id="@+id/commandInput" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:background="@null"
            android:hint="comando" android:textColorHint="#6B6B75"
            android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="15sp"
            android:imeOptions="actionSend" android:singleLine="true"
            android:inputType="text|textNoSuggestions"/>

        <ImageView android:id="@+id/sendButton" android:layout_width="44dp"
            android:layout_height="44dp" android:padding="12dp"
            android:background="@drawable/bg_send" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
