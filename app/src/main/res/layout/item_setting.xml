<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">

    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/setTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#F2F2F7" android:textSize="17sp"/>
        <TextView android:id="@+id/setSummary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:textColor="#9A9AA5" android:textSize="15sp" android:visibility="gone"/>
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat android:id="@+id/setSwitch"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:clickable="false" android:focusable="false" android:visibility="gone"/>
</LinearLayout>
