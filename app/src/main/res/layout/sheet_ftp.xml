<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_sheet"
    android:padding="24dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Servidor FTP" android:textColor="#F2F2F7" android:textSize="18sp"/>
            <TextView android:id="@+id/ftpStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#9A9AA5" android:textSize="13sp"/>
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/ftpSwitch"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:id="@+id/ftpAddress" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="18dp"
        android:padding="14dp" android:background="#2A2A33" android:textColor="#B8C4FF"
        android:textSize="16sp" android:fontFamily="monospace" android:textIsSelectable="true"/>

    <TextView android:id="@+id/ftpCred" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:textColor="#F2F2F7" android:textSize="14sp" android:fontFamily="monospace"
        android:lineSpacingExtra="4dp"/>

    <TextView android:id="@+id/ftpNewPass" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:padding="8dp" android:text="Gerar nova senha" android:textColor="#B8C4FF"
        android:textSize="14sp" android:background="?attr/selectableItemBackground"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#9A9AA5" android:textSize="12sp"
        android:text="O FTP nao e criptografado. Use apenas em Wi-Fi de confianca. Quem tiver a senha acessa todo o armazenamento."/>
</LinearLayout>
